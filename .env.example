# Postgres connection (Supabase -> Project Settings -> Database -> Connection string)
# Pooled connection, used at runtime:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection, used by `prisma migrate`:
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Resend (https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Where the contact-form notification is delivered
CONTACT_NOTIFY_EMAIL="tarangvizag@gmail.com"
# Must be a domain verified in Resend. `onboarding@resend.dev` works for testing.
CONTACT_FROM_EMAIL="portfolio@resend.dev"
