generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// The database's only job: storing contact-form submissions.
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
